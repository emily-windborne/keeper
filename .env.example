# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use either name (same value: "anon" / public key from the dashboard)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Phone notifications. Add these same names in the Vercel project settings.
# Generate the two keys once, on your computer:
#   npx web-push generate-vapid-keys
# The public key is safe in the browser. The private key must stay on the server.
# After you add the public key, redeploy so the app can see it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push service. Use your email, like mailto:you@example.com
VAPID_SUBJECT=mailto:you@example.com

# Make up a long random password. Vercel sends it when the scheduled job runs.
# Put the same value in Vercel as CRON_SECRET.
CRON_SECRET=

# Supabase → Project Settings → API → service_role.
# Server only. Never start this name with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
